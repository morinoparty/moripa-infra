# {{ ansible_managed }}
# ノードのアドレスはクラスタ用の第 2 サブネット(lan_address)。DHCP で貰う LAN IP は
# 使わない(docs/content/docs/architecture/wireguard.mdx)
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
# kube-proxy は入れない(Cilium の kube-proxy replacement を使う)
skipPhases:
  - addon/kube-proxy
nodeRegistration:
  criSocket: unix:///run/containerd/containerd.sock
localAPIEndpoint:
  advertiseAddress: {{ lan_address }}
  bindPort: {{ kube_api_port }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "{{ k8s_full_version }}"
controlPlaneEndpoint: "{{ kube_vip_address }}:{{ kube_api_port }}"
networking:
  podSubnet: "{{ pod_cidr }}"
  serviceSubnet: "{{ service_cidr }}"
apiServer:
  # VIP と各 CP の lan_address に加え、wg アドレスも SAN に入れる
  # (管理者は VIP に届かないので wg アドレスで API に接続する)
  certSANs:
    - "{{ kube_vip_address }}"
{% for h in groups[k8s_cp_group] %}
    - "{{ hostvars[h].lan_address }}"
    - "{{ hostvars[h].wg_address }}"
{% endfor %}
# kubelet の node-ip は roles/k8s_prereq が /etc/default/kubelet で lan_address に固定する
# (worker の join にも効かせるため kubeadm config ではなくそちらで設定)
