# {{ ansible_managed }}
# 生成元: ansible/group_vars/all/network.yml の proxy_routes
# 各ホスト名を対象拠点の全ノード :80(Cilium Gateway, hostNetwork)へ wg 越しに転送する。
# ヘルスチェックは passive のみ: ホスト名不一致時に Envoy が 404 を返すため
# active check(health_uri)は使えない。失敗した upstream は fail_duration の間
# 外され、lb_try_duration 内で別ノードへ再試行する。
# admin API(reload に必要)は既定のまま localhost:2019 で有効
{
	email {{ proxy_acme_email }}
}

{% for r in proxy_routes %}
{{ r.host }} {
	reverse_proxy {% for h in groups[r.site] | intersect(groups['k8s_cluster']) | sort %}{{ hostvars[h].wg_address }}:80{{ ' ' if not loop.last }}{% endfor %} {
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 30s
	}
}

{% endfor %}
