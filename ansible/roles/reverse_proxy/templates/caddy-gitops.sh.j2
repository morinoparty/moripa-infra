#!/usr/bin/env bash
# {{ ansible_managed }}
# Pull {{ caddy_gitops_subdir }}/ from git, validate the Caddyfile, then apply it.
# Run by caddy-gitops.timer every {{ caddy_gitops_interval }}. Manual run: systemctl start caddy-gitops
# Logs: journalctl -u caddy-gitops
set -euo pipefail

repo_url="{{ caddy_gitops_repo_url }}"
branch="{{ caddy_gitops_branch }}"
subdir="{{ caddy_gitops_subdir }}"
work=/var/lib/caddy-gitops/repo
dest=/etc/caddy

if [ ! -d "$work/.git" ]; then
  git clone --quiet --depth 1 --branch "$branch" "$repo_url" "$work"
else
  git -C "$work" fetch --quiet --depth 1 origin "$branch"
  git -C "$work" reset --quiet --hard "origin/$branch"
fi
rev=$(git -C "$work" rev-parse --short HEAD)
src="$work/$subdir"

if [ ! -f "$src/Caddyfile" ]; then
  echo "caddy-gitops: $subdir/Caddyfile not found on $branch ($rev); nothing to do" >&2
  exit 0
fi

# Static files (login chooser page etc.). No reload needed.
mkdir -p "$dest/www"
rsync -a --delete --chmod=D0755,F0644 "$src/www/" "$dest/www/"

# The Caddyfile imports generated.caddy (written by Ansible) from the same
# directory, so it must be placed under /etc/caddy before validation.
if cmp -s "$src/Caddyfile" "$dest/Caddyfile"; then
  exit 0
fi
install -m 0644 "$src/Caddyfile" "$dest/Caddyfile.new"
if ! caddy validate --adapter caddyfile --config "$dest/Caddyfile.new" --envfile "$dest/env" >/dev/null 2>"$dest/Caddyfile.new.err"; then
  echo "caddy-gitops: validation of Caddyfile ($rev) failed; keeping the current config" >&2
  cat "$dest/Caddyfile.new.err" >&2
  rm -f "$dest/Caddyfile.new"
  exit 1
fi
rm -f "$dest/Caddyfile.new.err"
mv -f "$dest/Caddyfile.new" "$dest/Caddyfile"
systemctl try-reload-or-restart caddy
echo "caddy-gitops: updated Caddyfile to $rev and reloaded caddy"
