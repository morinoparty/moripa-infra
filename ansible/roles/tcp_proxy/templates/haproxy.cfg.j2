# {{ ansible_managed }}
# 生成元: ansible/group_vars/all/network.yml の tcp_routes
# 各 port を対象拠点の全ノードの NodePort(node_port)か、指定ホスト(hosts)の
# target_port(省略時は同じ port)へ L4 で転送する(実IPは届かない)。
# minecraft_hosts を持つ route は、handshake の接続先ホスト名でバックエンドを選ぶ。
# 送信元の制限(allowed_sources)は nftables 側で行う

global
    log /dev/log local0
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn 4096

defaults
    mode tcp
    log global
    option tcplog
    option dontlognull
    timeout connect 5s
    # Minecraft は長寿命の TCP セッション。既定の 50s だと放置中のプレイヤーが切られる
    timeout client 1h
    timeout server 1h

{% for r in tcp_routes %}
{% if r.minecraft_hosts is defined %}
# Minecraft の handshake(平文、最初のパケット)には接続先ホスト名がそのまま入るので、
# 受信済みのデータ全体(req.payload(0,0))をホスト名で部分一致させる(HTTPS の SNI 相当)。
# バイナリのまま -m sub で比べると、先頭付近の 0x00(パケット ID)で文字列が切れて一致しない
# ため、hex に変換してホスト名の hex と比べる。Forge の "\0FML..." や末尾の "." が付いても通る。
# 先頭 N バイトに絞ると長いホスト名が途中で切れるので、長さは指定しない
frontend {{ r.name }}
    # v4 と v6(Cloud Firewall は両方通す)
    bind :::{{ r.port }} v4v6
    tcp-request inspect-delay 3s
    # handshake が届いたら判定する(届かないまま 3 秒で下の reject)
    tcp-request content accept if { req.len gt 0 }
{% for m in r.minecraft_hosts %}
    # {{ m.host }}
    use_backend {{ r.name }}_{{ m.host | replace('.', '_') }} if { req.payload(0,0),hex -m sub {{ m.host.encode('utf-8').hex() | upper }} }
{% endfor %}
    default_backend {{ r.name }}_reject

{% for m in r.minecraft_hosts %}
backend {{ r.name }}_{{ m.host | replace('.', '_') }}
    server {{ m.server }} {{ hostvars[m.server].wg_address }}:{{ m.port }} check inter 5s fall 2 rise 2

{% endfor %}
backend {{ r.name }}_reject
    tcp-request content reject

{% else %}
{% if r.hosts is defined %}
{% set targets = r.hosts %}
{% set target_port = r.target_port | default(r.port) %}
{% else %}
{% set targets = groups[r.site] | intersect(groups['k8s_cluster']) | sort %}
{% set target_port = r.node_port %}
{% endif %}
listen {{ r.name }}
    # v4 と v6(Cloud Firewall は両方通す。gw.morino.party の AAAA 経由の接続もある)
    bind :::{{ r.port }} v4v6
    balance leastconn
{% for h in targets %}
    server {{ h }} {{ hostvars[h].wg_address }}:{{ target_port }} check inter 5s fall 2 rise 2
{% endfor %}

{% endif %}
{% endfor %}
