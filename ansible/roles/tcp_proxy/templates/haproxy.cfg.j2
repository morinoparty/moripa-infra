# {{ ansible_managed }}
# 生成元: ansible/group_vars/all/network.yml の tcp_routes
# 各 port を対象拠点の全ノードの NodePort(node_port)か、指定ホスト(hosts)の
# target_port(省略時は同じ port)へ L4 で転送する(実IPは届かない)。
# 送信元の制限(allowed_sources)は nftables 側で行う

global
    log /dev/log local0
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn 4096

defaults
    mode tcp
    log global
    option tcplog
    option dontlognull
    timeout connect 5s
    # Minecraft は長寿命の TCP セッション。既定の 50s だと放置中のプレイヤーが切られる
    timeout client 1h
    timeout server 1h

{% for r in tcp_routes %}
{% if r.hosts is defined %}
{% set targets = r.hosts %}
{% set target_port = r.target_port | default(r.port) %}
{% else %}
{% set targets = groups[r.site] | intersect(groups['k8s_cluster']) | sort %}
{% set target_port = r.node_port %}
{% endif %}
listen {{ r.name }}
    # v4 と v6(Cloud Firewall は両方通す。gw.morino.party の AAAA 経由の接続もある)
    bind :::{{ r.port }} v4v6
    balance leastconn
{% for h in targets %}
    server {{ h }} {{ hostvars[h].wg_address }}:{{ target_port }} check inter 5s fall 2 rise 2
{% endfor %}

{% endfor %}
