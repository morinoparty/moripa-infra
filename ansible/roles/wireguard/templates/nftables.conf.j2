#!/usr/sbin/nft -f
# {{ ansible_managed }}
# hub(Linode)のファイアウォール + NAT。
# 外側に Linode Cloud Firewall(terraform 管理)があり二重防御になっている。
# 公開ポート(proxy_public_ports + tcp_routes)は terraform の public_tcp_ports とも一致させること。

flush ruleset

table inet filter {
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
    ip protocol icmp accept
    meta l4proto ipv6-icmp accept
    udp dport {{ wg_port }} accept
    # wg 内の DNS(dnsmasq)。wg0 からのみ
    iifname "{{ wg_interface }}" meta l4proto { tcp, udp } th dport 53 accept
    # Caddy(HTTP/HTTPS リバースプロキシ)の公開ポート。ACME HTTP-01 にも 80 が必要
    tcp dport { {{ proxy_public_ports | join(', ') }} } accept
{% for r in tcp_routes %}
    # HAProxy: {{ r.name }} → {{ r.site }} の NodePort {{ r.node_port }}
{% if r.allowed_sources | default([]) | length > 0 %}
    tcp dport {{ r.port }} ip saddr { {{ r.allowed_sources | join(', ') }} } accept
{% else %}
    tcp dport {{ r.port }} accept
{% endif %}
{% endfor %}
    # SSH はホストでは全面許可し、公開可否は Cloud Firewall 側で制御する
    # (定常状態は bootstrap_ssh_cidrs=[] で公開されず、wg 経由のみ届く)
    tcp dport 22 accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    # wg(MTU {{ wg_mtu }})を通る TCP の MSS を経路 MTU に clamp
    tcp flags syn tcp option maxseg size set rt mtu
    ct state established,related accept
    ct state invalid drop
    # spoke → internet(フルトンネルの egress)
    iifname "{{ wg_interface }}" oifname "{{ gateway_wan_interface }}" accept
    # wg peer 同士(管理者マシン → ノードの SSH / API 等)
    iifname "{{ wg_interface }}" oifname "{{ wg_interface }}" accept
  }
}

table inet nat {
  chain postrouting {
    type nat hook postrouting priority srcnat;
    # egress のみ masquerade。Caddy / HAProxy → ノードの通信はハブ自身
    # (10.100.0.1)発なので wg0 へそのまま出る(NAT 不要)
    oifname "{{ gateway_wan_interface }}" ip saddr {{ wg_cidr }} masquerade
  }
}
