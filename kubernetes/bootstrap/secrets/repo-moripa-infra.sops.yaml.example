# ArgoCD の private repo アクセス用(GitHub read-only deploy key)。
# 実値を入れたら必ず `sops -e -i` で暗号化すること(README.md 参照)
apiVersion: v1
kind: Secret
metadata:
  name: repo-moripa-infra
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  name: moripa-infra
  url: git@github.com:morinoparty/moripa-infra.git
  sshPrivateKey: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    REPLACE_WITH_DEPLOY_PRIVATE_KEY
    -----END OPENSSH PRIVATE KEY-----
