# Let's Encrypt の ClusterIssuer(DNS-01)。
# HTTP-01 は「DNAT 先ノード固定」に依存するため DNS-01 を推奨。
# 使い方:
#   1. DNS プロバイダのトークン Secret を ksops で作成(secret-generator 経由)
#   2. このファイルを clusterissuer.yaml にコピーして solver を自分の
#      プロバイダに合わせ、kustomization.yaml の resources に追加
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt
  annotations:
    # CRD 未適用時の dry-run 失敗を無視(初回同期順対策)
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: yahiro@morino.party
    privateKeySecretRef:
      name: letsencrypt-account-key
    solvers:
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: cloudflare-api-token
              key: api-token
