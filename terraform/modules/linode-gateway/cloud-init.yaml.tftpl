#cloud-config
# 最小限のブートストラップのみ。wireguard / nftables 等の構成は Ansible の責務
users:
  - name: ${admin_username}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
%{ for key in admin_ssh_keys ~}
      - ${key}
%{ endfor ~}
disable_root: true
ssh_pwauth: false
package_update: true
packages:
  - python3
